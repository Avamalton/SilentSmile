# Runtime Environment
NODE_ENV="production"
PORT="3000"

# APP_URL: Public URL where SilentSmile Exchange is hosted (e.g. https://ncue.fun)
APP_URL="https://ncue.fun"

# JWT Secrets: Generate strong random strings before deploying to production
JWT_ACCESS_SECRET="CHANGE_ME_STRONG_RANDOM_ACCESS_SECRET"
JWT_REFRESH_SECRET="CHANGE_ME_STRONG_RANDOM_REFRESH_SECRET"

# GEMINI_API_KEY: Optional API key if AI features are enabled
GEMINI_API_KEY="MY_GEMINI_API_KEY"
